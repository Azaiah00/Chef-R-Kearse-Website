# Chef R. Kearse — environment
#
# Every variable here is OPTIONAL. With none of them set the enquiry form still
# works end to end and logs each submission to the server console, so the site
# can be demoed before the client has handed over a single credential.

# Email delivery for the enquiry form (https://resend.com).
# Without this key, submissions are logged instead of sent.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to chefrkearse@gmail.com.
INQUIRY_TO=chefrkearse@gmail.com

# The From: header. Must be a domain verified inside Resend.
# Until a domain is verified, Resend's sandbox sender works:
#   Website Enquiry <onboarding@resend.dev>
INQUIRY_FROM="Chef R. Kearse Website <enquiries@chefrkearse.com>"
