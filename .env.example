# Chef R. Kearse — environment
#
# Every variable here is OPTIONAL. With none of them set the enquiry form still
# works end to end and logs each submission to the server console, so the site
# can be demoed before the client has handed over a single credential.

# Public site URL for canonical links, Open Graph, sitemap, and schema.
# On Netlify, URL is set automatically; use this to override (no trailing slash).
# SITE_URL=https://chef-r-kearse-website.netlify.app

# Email delivery for the enquiry form (https://resend.com).
# Without this key, submissions are logged instead of sent.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to chefrkearse@gmail.com.
INQUIRY_TO=chefrkearse@gmail.com

# The From: header. Must be a domain verified inside Resend.
# Until a domain is verified, Resend's sandbox sender works:
#   Website Enquiry <onboarding@resend.dev>
INQUIRY_FROM="Chef R. Kearse Website <enquiries@chefrkearse.com>"

# DEMO MODE — one switch for everything that exists only to demonstrate this
# build: the "Portal" button in the site header and mobile menu, the one-tap
# role buttons on the sign-in page, the printed demo accounts, and the
# /api/portal/demo-login endpoint behind those buttons.
#
# It defaults to ON so the build demonstrates itself with no configuration.
# Set it to false before this site is pointed at a real domain — with it on,
# anyone who reaches /portal/login can open the owner's portal with one tap.
# That is fine for a private demo holding invented data, and not fine the
# moment a real enquiry lands in there.
# NEXT_PUBLIC_DEMO_MODE=false
